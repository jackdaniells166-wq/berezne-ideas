# Скопіюйте цей файл у .env та підставте власні значення.
# .env НЕ комітиться в репозиторій (додано в .gitignore).

# Рядок підключення до MongoDB Atlas (Database → Connect → Drivers)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/berezne?retryWrites=true&w=majority

# Назва бази даних
MONGODB_DB=berezne

# Дані для входу в адмін-панель (вигадайте самі, не пов'язані з MongoDB)
ADMIN_LOGIN=admin
ADMIN_PASSWORD=change-me

# Секрет для підпису JWT-токенів (будь-який довгий випадковий рядок)
JWT_SECRET=change-me-too

# Порт (опційно, Render підставляє свій автоматично)
PORT=3000
